@using THLapTrinhWeb.Models
@model ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-5 fw-bold text-primary">
                <i class="fas fa-shopping-cart me-3"></i>Your Shopping Cart
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Shopping Cart</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model?.Items != null && Model.Items.Any())
    {
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>Cart Items (@Model.Items.Count items)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item border-bottom p-4 @(Model.Items.Last() == item ? "" : "border-bottom")">
                                <div class="row align-items-center">
                                    <!-- Product Image -->
                                    <div class="col-md-2 text-center mb-3 mb-md-0">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" 
                                                 class="img-fluid rounded shadow-sm" 
                                                 style="height: 80px; width: 80px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center rounded shadow-sm" 
                                                 style="height: 80px; width: 80px;">
                                                <i class="fas fa-image fa-2x text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- Product Info -->
                                    <div class="col-md-4 mb-3 mb-md-0">
                                        <h6 class="fw-bold text-dark mb-1">@item.ProductName</h6>
                                        <p class="text-muted mb-0">
                                            <i class="fas fa-tag me-1"></i>Unit Price: 
                                            <span class="fw-semibold">@item.Price.ToString("#,##0") VNĐ</span>
                                        </p>
                                    </div>
                                    
                                    <!-- Quantity -->
                                    <div class="col-md-2 text-center mb-3 mb-md-0">
                                        <div class="input-group input-group-sm justify-content-center">
                                            <button class="btn btn-outline-secondary" type="button" 
                                                    onclick="updateQuantity(@item.ProductId, @(item.Quantity - 1))">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <input type="text" class="form-control text-center fw-bold" 
                                                   value="@item.Quantity" readonly style="max-width: 60px;">
                                            <button class="btn btn-outline-secondary" type="button" 
                                                    onclick="updateQuantity(@item.ProductId, @(item.Quantity + 1))">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted">Quantity</small>
                                    </div>
                                    
                                    <!-- Total Price -->
                                    <div class="col-md-3 text-center mb-3 mb-md-0">
                                        <h6 class="fw-bold text-primary mb-1">
                                            @((item.Price * item.Quantity).ToString("#,##0")) VNĐ
                                        </h6>
                                        <small class="text-muted">Total</small>
                                    </div>
                                    
                                    <!-- Remove Button -->
                                    <div class="col-md-1 text-center">
                                        <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId" 
                                           class="btn btn-outline-danger btn-sm" 
                                           onclick="return confirm('Are you sure you want to remove this item?')"
                                           data-bs-toggle="tooltip" title="Remove from cart">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Continue Shopping -->
                <div class="mt-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>
            
            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-receipt me-2"></i>Order Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Items Count -->
                        <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                            <span class="fw-semibold">
                                <i class="fas fa-box me-2 text-primary"></i>Items in Cart:
                            </span>
                            <span class="badge bg-primary rounded-pill">@Model.GetTotalQuantity()</span>
                        </div>
                        
                        <!-- Price Breakdown -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <span class="fw-semibold">@Model.GetTotalPrice().ToString("#,##0") VNĐ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping:</span>
                                <span class="text-success fw-semibold">
                                    <i class="fas fa-shipping-fast me-1"></i>FREE
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax:</span>
                                <span>@((Model.GetTotalPrice() * 0.1m).ToString("#,##0")) VNĐ</span>
                            </div>
                            <hr class="my-3">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 class="fw-bold">Total:</h5>
                                <h5 class="fw-bold text-success">
                                    @((Model.GetTotalPrice() * 1.1m).ToString("#,##0")) VNĐ
                                </h5>
                            </div>
                        </div>
                        
                        <!-- Promo Code -->
                        <div class="mb-4">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Promo code">
                                <button class="btn btn-outline-secondary" type="button">
                                    <i class="fas fa-tag"></i> Apply
                                </button>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-success btn-lg">
                                <i class="fas fa-credit-card me-2"></i>Proceed to Checkout
                            </a>
                            <button class="btn btn-outline-warning" onclick="clearCart()">
                                <i class="fas fa-trash-alt me-2"></i>Clear Cart
                            </button>
                        </div>
                        
                        <!-- Security Info -->
                        <div class="mt-4 p-3 bg-light rounded">
                            <div class="row text-center">
                                <div class="col-4">
                                    <i class="fas fa-shield-alt fa-2x text-success mb-2"></i>
                                    <small class="d-block">Secure Payment</small>
                                </div>
                                <div class="col-4">
                                    <i class="fas fa-truck fa-2x text-primary mb-2"></i>
                                    <small class="d-block">Fast Delivery</small>
                                </div>
                                <div class="col-4">
                                    <i class="fas fa-undo fa-2x text-warning mb-2"></i>
                                    <small class="d-block">Easy Returns</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart -->
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm text-center">
                    <div class="card-body py-5">
                        <i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
                        <h3 class="text-muted mb-3">Your cart is empty</h3>
                        <p class="text-muted mb-4">
                            Looks like you haven't added anything to your cart yet. 
                            Start shopping to fill it up!
                        </p>
                        
                        <!-- Quick Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="fas fa-shopping-bag me-2"></i>Start Shopping
                            </a>
                            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-tags me-2"></i>Browse Categories
                            </a>
                        </div>
                        
                        <!-- Featured Categories -->
                        <div class="mt-4 pt-4 border-top">
                            <h6 class="text-muted mb-3">Popular Categories</h6>
                            <div class="row">
                                <div class="col-6 col-md-3 mb-2">
                                    <a href="#" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="fas fa-laptop me-1"></i>Electronics
                                    </a>
                                </div>
                                <div class="col-6 col-md-3 mb-2">
                                    <a href="#" class="btn btn-outline-success btn-sm w-100">
                                        <i class="fas fa-tshirt me-1"></i>Fashion
                                    </a>
                                </div>
                                <div class="col-6 col-md-3 mb-2">
                                    <a href="#" class="btn btn-outline-warning btn-sm w-100">
                                        <i class="fas fa-home me-1"></i>Home
                                    </a>
                                </div>
                                <div class="col-6 col-md-3 mb-2">
                                    <a href="#" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-dumbbell me-1"></i>Sports
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- JavaScript Functions -->
<script>
function updateQuantity(productId, newQuantity) {
    if (newQuantity < 1) {
        if (confirm('Remove this item from cart?')) {
            window.location.href = `/ShoppingCart/RemoveFromCart?productId=${productId}`;
        }
        return;
    }
    function removeFromCart(productId) {
        $.post("/ShoppingCart/RemoveFromCartAjax", { productId }, function (data) {
            if (data.success) {
                alert(data.message);
                location.reload(); // or remove item from DOM
            } else {
                alert("Failed: " + data.message);
            }
        });
    }
    // Create a form to submit quantity update
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/ShoppingCart/UpdateQuantity';
    
    const productIdInput = document.createElement('input');
    productIdInput.type = 'hidden';
    productIdInput.name = 'productId';
    productIdInput.value = productId;
    
    const quantityInput = document.createElement('input');
    quantityInput.type = 'hidden';
    quantityInput.name = 'quantity';
    quantityInput.value = newQuantity;
    
    form.appendChild(productIdInput);
    form.appendChild(quantityInput);
    
    document.body.appendChild(form);
    form.submit();
}

function clearCart() {
    if (confirm('Are you sure you want to clear your entire cart?')) {
        window.location.href = '/ShoppingCart/ClearCart';
    }
}

// Initialize tooltips
document.addEventListener('DOMContentLoaded', function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>

<!-- Sửa phần CSS cuối file -->
<style>
.cart-item {
    transition: all 0.3s ease;
}

.cart-item:hover {
    background-color: #f8f9fa;
}

.sticky-top {
    top: 20px;
}

.card {
    transition: all 0.3s ease;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
}

.btn {
    transition: all 0.3s ease;
}

.btn:hover {
    transform: translateY(-1px);
}

/* Custom animations */
fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.cart-item {
    animation: fadeInUp 0.5s ease-out;
}

/* Responsive adjustments */
(max-width: 768px) {
    .sticky-top {
        position: relative !important;
        top: auto !important;
    }
}
</style>