@model THLapTrinhWeb.Models.Category

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h2 class="mb-0">Category Details</h2>
        </div>
        <div class="card-body">
            <h4 class="mb-3">ID: @Model.Id</h4>
