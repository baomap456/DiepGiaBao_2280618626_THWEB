@model IEnumerable<THLapTrinhWeb.Models.Category>

@{
    ViewData["Title"] = "Category List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary mr-2">Product</a>
        <a asp-controller="Category" asp-action="Index" class="btn btn-primary">Category</a>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>Categories</h2>
        </div>
        <div class="card-body">
            <a asp-action="Add" class="btn btn-success mb-3">Add Category</a>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Name</td>
                        <td>
                            <a asp-action="Display" asp-route-id="@category.Id" class="btn btn-info btn-sm">View</a>
                            <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>