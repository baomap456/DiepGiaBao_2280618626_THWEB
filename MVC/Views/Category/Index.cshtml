@model IEnumerable<THLapTrinhWeb.Models.Category>

@{
    ViewData["Title"] = "Browse Categories";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-4"><i class="fas fa-tags"></i> Browse by Category</h1>
            <p class="lead text-muted">Choose a category to explore our products</p>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary me-2">
            <i class="fas fa-shopping-bag"></i> All Products
        </a>
        <a asp-controller="Category" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-tags"></i> Categories
        </a>
    </div>

    <!-- Categories Grid -->
    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card category-card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="category-icon mb-3">
                            <!-- Dynamic icons based on category name -->
                            @{
                                string iconClass = category.Name.ToLower() switch
                                {
                                    var name when name.Contains("electronic") || name.Contains("tech") => "fas fa-laptop",
                                    var name when name.Contains("fashion") || name.Contains("cloth") => "fas fa-tshirt",
                                    var name when name.Contains("home") || name.Contains("house") => "fas fa-home",
                                    var name when name.Contains("sport") || name.Contains("fitness") => "fas fa-dumbbell",
                                    var name when name.Contains("book") || name.Contains("education") => "fas fa-book",
                                    var name when name.Contains("food") || name.Contains("kitchen") => "fas fa-utensils",
                                    var name when name.Contains("beauty") || name.Contains("cosmetic") => "fas fa-palette",
                                    var name when name.Contains("toy") || name.Contains("game") => "fas fa-gamepad",
                                    _ => "fas fa-tag"
                                };
                            }
                            <i class="@iconClass fa-4x text-primary"></i>
                        </div>

                        <h4 class="card-title">@category.Name</h4>

                        <!-- Product count (you'll need to implement this in controller) -->
                        <p class="text-muted small mb-3">
                            <i class="fas fa-box"></i> @ViewBag.ProductCounts?[category.Id] products available
                        </p>

                        <!-- Button to view products in this category -->
                        <a asp-controller="Product" asp-action="Index" asp-route-category="@category.Name"
                            class="btn btn-primary btn-lg">
                            <i class="fas fa-eye"></i> View Products
                        </a>

                        <!-- Admin actions (only show if user is admin) -->
                        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                        {
                            <div class="mt-3 border-top pt-3">
                                <div class="btn-group w-100" role="group">
                                    <a asp-action="Display" asp-route-id="@category.Id" class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-info"></i> Details
                                    </a>
                                    <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-outline-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this category?')">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty state -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-tags fa-5x text-muted mb-3"></i>
            <h3 class="text-muted">No categories available</h3>
            <p class="text-muted">Categories will appear here once they are added.</p>
            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <a asp-action="Add" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add First Category
                </a>
            }
        </div>
    }

    <!-- Admin Add Button -->
    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
        <div class="text-center mt-4">
            <a asp-action="Add" class="btn btn-success btn-lg">
                <i class="fas fa-plus"></i> Add New Category
            </a>
        </div>
    }
</div>

<style>
    .category-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .category-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
    }

    .category-icon {
        transition: all 0.3s ease;
    }

    .category-card:hover .category-icon {
        transform: scale(1.1);
    }
</style>