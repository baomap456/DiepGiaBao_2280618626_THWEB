@using THLapTrinhWeb.Extensions
@using THLapTrinhWeb.Models
@model Order

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="display-5 fw-bold text-primary mb-4">
                <i class="fas fa-credit-card me-3"></i>Checkout
            </h2>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Shipping Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Checkout" method="post">
                        <div class="mb-3">
                            <label class="form-label">Shipping Address *</label>
                            <input name="ShippingAddress" class="form-control" placeholder="Enter address..."
                                required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Notes (Optional)</label>
                            <input name="Notes" class="form-control" placeholder="Optional notes..." />
                        </div>

                        <button type="submit" class="btn btn-success">
                            Place Order
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @{
                var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart");
            }

            @if (cart != null && cart.Items.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <div>
                                    <h6 class="mb-0">@item.ProductName</h6>
                                    <small class="text-muted">Qty: @item.Quantity</small>
                                </div>
                                <span>@((item.Price * item.Quantity).ToString("#,##0")) VNĐ</span>
                            </div>
                        }
                        <hr>
                        <div class="d-flex justify-content-between">
                            <strong>Total:</strong>
                            <strong class="text-success">@cart.GetTotalPrice().ToString("#,##0") VNĐ</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>